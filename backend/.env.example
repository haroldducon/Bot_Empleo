# Copia este archivo como .env y completa valores locales.
DATABASE_URL=postgresql+psycopg://usuario:contrasena@localhost:5432/bot_empleos
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REEMPLAZAR_POR_UNA_CLAVE_FERNET_VALIDA
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=1440
GEMINI_MODEL=gemini-flash-latest
# Opcional: clave REST de Jooble Colombia; solicita acceso en https://co.jooble.org/api/about
JOOBLE_API_KEY=

# Opcional: OAuth web de Google para leer alertas LinkedIn de un Gmail dedicado.
# Registra esta URI exacta como redirect URI del cliente OAuth en Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/gmail/oauth/callback
# Opcional: recuperación de contraseña por correo. Configura valores reales solo en Render.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
PASSWORD_RESET_MINUTES=30
